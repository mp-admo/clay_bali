---
import { translations } from "../i18n";

const isHome = Astro.url.pathname === "/";
---

<header class="header">

	<div class="container">
		<nav class="header__nav">

			<a href={isHome ? "#top" : "/"} class="header__nav-link" data-i18n="home">
				{translations.en.home}
			</a>

			<a href="/menu" class="header__nav-link" data-i18n="menu">
				{translations.en.menu}
			</a>

			<a href="/events" class="header__nav-link" data-i18n="events">
				{translations.en.events}
			</a>

			<a href="/philosophy" class="header__nav-link" data-i18n="philosophy">
				{translations.en.philosophy}
			</a>

			<a href="/contact" class="header__nav-link" data-i18n="contact">
				{translations.en.contact}
			</a>
		</nav>

		<div class="header__actions">
			<div class="header__language">
				<button type="button" data-language="en">EN</button>
				<span>/</span>
				<button type="button" data-language="id">ID</button>
			</div>

			<button type="button" class="header__book" data-i18n="book">
				{translations.en.book}
			</button>
		</div>

	</div>

</header>

<button class="burger-button" aria-label="Open menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

<div class="mobile-menu">

	<div class="mobile-menu__language">
		<button type="button" data-language="en">EN</button>
		<span>/</span>
		<button type="button" data-language="id">ID</button>
	</div>

    <nav class="mobile-menu__nav">

        <a href={isHome ? "#top" : "/"} class="mobile-menu__link" data-i18n="home">
			{translations.en.home}
		</a>

		<a href="/menu" class="mobile-menu__link" data-i18n="menu">
			{translations.en.menu}
		</a>

		<a href="/events" class="mobile-menu__link" data-i18n="events">
			{translations.en.events}
		</a>

		<a href="/philosophy" class="mobile-menu__link" data-i18n="philosophy">
			{translations.en.philosophy}
		</a>

		<a href="/contact" class="mobile-menu__link" data-i18n="contact">
			{translations.en.contact}
		</a>

    </nav>

</div>

<style>

	.header {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		padding: 4rem 0;
		z-index: 100;
		display: flex;
		align-items: center;
	}

	.container {
		width: 100%;
		max-width: 140rem;
		padding: 0 2rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.header__nav {
		display: flex;
		align-items: center;
		gap: 3rem;
	}

	.header__nav-link {
		color: #FFF1D3;
		font-family: 'Montserrat';
		font-size: 1.6rem;
		font-weight: 400;
		line-height: 1.1;
		text-decoration: none;
		transition: opacity 0.3s ease;
	}

	.header__nav-link:hover {
		opacity: 0.6;
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 4rem;
	}

	.header__language {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: 'Montserrat', sans-serif;
		font-size: 1.6rem;
		font-weight: 400;
		line-height: 1.1;
	}

	.header__language button {
		padding: 0;
		border: none;
		background: transparent;
		color: rgba(255, 241, 211, 0.4);
		cursor: pointer;
	}

	.header__language button.is-active {
		color: #FFF1D3;
	}

	.header__language span {
		color: #FFF1D3;
	}

	.header__book {
		padding: 0;
		border: 0;
		background: transparent;
		color: #FFF1D3;
		font-family: 'Montserrat', sans-serif;
		font-size: 1.6rem;
		font-weight: 500;
		line-height: 1.1;
		text-transform: uppercase;
		cursor: pointer;
		transition: opacity 0.3s ease;
	}

	.header__book:hover {
		opacity: 0.6;
	}

	.burger-button {
        display: none;
    }

	.mobile-menu {
        position: fixed;
		top: 0;
        left: 0;
        width: 100%;
        height: 100dvh;
        background-color: #131313;
        padding: 4rem 3rem;
        display: flex;
        flex-direction: column;
        opacity: 0;
        visibility: hidden;
        transition: 0.3s ease;
        z-index: 200;
        gap: 10rem;
    }


	.mobile-menu.is-open {
        opacity: 1;
        visibility: visible;
    }

	.mobile-menu__close span:first-child {
        transform: translate(-50%, -50%) rotate(45deg);
    }

    .mobile-menu__close span:last-child {
        transform: translate(-50%, -50%) rotate(-45deg);
    }

	.mobile-menu__nav {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

	.mobile-menu__link {
        color: #FFF1D3;
		font-family: 'Montserrat';
		font-size: 1.8rem;
		font-weight: 400;
		line-height: 1.1;
        text-decoration: none;
    }

	.mobile-menu__language {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: 'Montserrat', sans-serif;
		font-size: 1.6rem;
		font-weight: 400;
		line-height: 1.1;
	}

	.mobile-menu__language button {
		padding: 0;
		border: none;
		background: transparent;
		color: rgba(255, 241, 211, 0.4);
		cursor: pointer;
	}

	.mobile-menu__language button.is-active {
		color: #FFF1D3;
	}

	.mobile-menu__language span {
		color: #FFF1D3;
	}

	@media (max-width: 1440px) {
	
		.container {
				padding: 0 5rem;
			}
		}

	@media (max-width: 768px) {


		.header__nav {
			display: none;
		}

		.container {
			padding: 0 3rem;
		}

		.header__actions {
			width: 100%;
			justify-content: flex-start;
		}

		.header__language {
			display: none;
		}

		.header__book {
			font-size: 1.4rem;
		}

		.header__menu,
        .header__button {
            display: none;
        }

        .header__nav {
            justify-content: space-between;
        }

        .burger-button {
            display: flex;
			position: fixed;
            right: 3rem;
			top: 3.5rem;
			flex-direction: column;
			justify-content: center;
			align-items: flex-end;
			gap: 0.4rem;
			width: 2.4rem;
			height: 2.4rem;
			padding: 0;
			border: none;
			background: transparent;
			cursor: pointer;
			overflow: hidden;
			z-index: 300;
        }

        .burger-button span {
            display: block;

            width: 2.4rem;
            height: 0.2rem;

            margin: 0;

            background-color: #FFF1D3;

            transition:
                transform 0.3s ease,
                opacity 0.3s ease;
        }

        .burger-button--active span:nth-child(1) {
            transform: translateY(0.6rem) rotate(45deg);
        }

        .burger-button--active span:nth-child(2) {
            opacity: 0;
        }

        .burger-button--active span:nth-child(3) {
            transform: translateY(-0.6rem) rotate(-45deg);
        }

	}

</style>

<script>
	import { translations, type Language } from "../i18n";

	const buttons = document.querySelectorAll<HTMLButtonElement>("[data-language]");
	const elements = document.querySelectorAll<HTMLElement>("[data-i18n]");

	type TranslationKey = keyof typeof translations.en;

	function setLanguage(language: Language) {
		const translation = translations[language];

		elements.forEach((element) => {
			const key = element.dataset.i18n as TranslationKey;

			if (translation[key]) {
				element.innerHTML = translation[key];
			}
		});

		document.documentElement.lang = language;

		localStorage.setItem("language", language);

		buttons.forEach((button) => {
			button.classList.toggle(
				"is-active",
				button.dataset.language === language
			);
		});
	}

	const savedLanguage = localStorage.getItem("language");

	const initialLanguage: Language =
		savedLanguage === "id" ? "id" : "en";

	setLanguage(initialLanguage);

	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			const language = button.dataset.language;

			if (language === "en" || language === "id") {
				setLanguage(language);
			}
		});
	});
</script>

<script>

    const burgerBtn = document.querySelector('.burger-button');
    const mobileMenu = document.querySelector('.mobile-menu');
    const menuLinks = document.querySelectorAll('.mobile-menu__link');

    if (burgerBtn && mobileMenu) {

        burgerBtn.addEventListener('click', () => {

            mobileMenu.classList.toggle('is-open');
            burgerBtn.classList.toggle('burger-button--active');

            if (mobileMenu.classList.contains('is-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }

        });

        menuLinks.forEach(link => {

            link.addEventListener('click', () => {

                mobileMenu.classList.remove('is-open');
                burgerBtn.classList.remove('burger-button--active');
                document.body.style.overflow = '';

            });

        });

    }

</script>