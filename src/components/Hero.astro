---

---

<section class="hero" id="top">

	<img class="hero__bg" src="/hero_background.png" alt="" draggable="false" />

	<div class="hero__branch">
		<img src="/branch_clay.png" alt="" draggable="false"/>
	</div>

	<div class="hero__logo">
		<img src="/logo_clay.svg" alt="Clay" draggable="false"/>
	</div>

    <div class="container">

        <div class="hero__bottom">

            <div class="hero__socials">
                <a href="#" aria-label="Facebook">
                    <img src="/facebook_icon_clay.svg" alt="" />
                </a>

                <a href="#" aria-label="Instagram">
                    <img src="/instagram_icon_clay.svg" alt="" />
                </a>

                <a href="#" aria-label="WhatsApp">
                    <img src="/whatsapp_icon_clay.svg" alt="" />
                </a>
            </div>

            <p class="hero__description" data-i18n="heroDescription"></p>

            <p class="hero__status" data-i18n="heroStatus"></p>

        </div>

    </div>

</section>

<style>

	.hero {
		position: relative;
		width: 100%;
		height: 100svh;
		overflow: hidden;
	}

	.hero__bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; 
        object-position: center; 
        z-index: 1; 
        pointer-events: none; 
        -webkit-user-drag: none; 
        }

	.hero__branch {
		position: absolute;
		top: 48%;
		right: 0;
		width: 75%;
		transform: translateY(-50%);
		z-index: 2;
	}

	.hero__branch img {
		width: 100%;
		height: auto;
	}

	.hero__logo {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 30rem;
		transform: translate(-50%, -50%);
		z-index: 3;
	}

	.hero__logo img {
		width: 100%;
		height: auto;
	}

	.hero .container {
		width: 100%;
		max-width: 140rem;
		padding: 0 2rem;
		margin: 0 auto;
        position: relative;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        pointer-events: none;
	}

	.hero__bottom {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        z-index: 4; 
        pointer-events: auto;
        padding-bottom: 10rem;
        cursor: default; 
    }

	.hero__socials {
		display: flex;
		align-items: center;
		gap: 4rem;
	}

	.hero__socials a {
		display: block;
		width: 2.4rem;
		height: 2.4rem;
	}

	.hero__socials img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.hero__description {
        color: #F2DFD0;
		text-align: center;
        line-height: 1.4;
	}

	.hero__status {
        color: #202020;
		text-align: right;
        line-height: 1.4;
	}

</style>