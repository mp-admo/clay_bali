---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Clay Bali">

    <section class="contact">|

        <div class="container">

            <div class="contact__header">

                <img
                    src="/images/logo_clay.svg"
                    alt="Clay"
                    class="contact__logo"
                >

                <h4 class="contact__slogan">
                    Find your way to Clay
                </h4>

            </div>

            <div class="contact__grid">

                <div class="contact__column">
                    
                    <h5 >Contacts</h5>

                    <div class="contact__item">
                        
                        <h5>WhatsApp</h5>
                        <span>+62 822 7314 5068</span>

                    </div>

                    <div class="contact__item">

                        <h5>Address</h5>
                        <span>
                            Jl. Raya Pengosekan No. 88,<br>
                            Ubud, Gianyar, Bali
                        </span>

                    </div>

                    <div class="contact__item">

                        <h5>Social Media</h5>

                        <div class="contact__socials">

                            <a href="#" class="contact__social">
                                <img src="/images/instagram.svg" alt="Instagram">
                                <span>Instagram</span>
                            </a>

                            <a href="#" class="contact__social">
                                <img src="/images/whatsapp.svg" alt="WhatsApp">
                                <span>WhatsApp</span>
                            </a>

                        </div>

                    </div>

                </div>

                <div class="contact__column">

                    <h5 class="contact__title">Opening Hource</h5>

                    <div class="contact__item">

                        <h5>Clay Restaurant</h5>
                        <p>Soon</p>

                    </div>

                    <div class="contact__item">

                        <h5>Private Events</h5>
                        <p>Available upon request</p>

                    </div>

                    <div class="contact__item">

                        <h5>Delivery</h5>

                        <div class="contact__socials">|

                            <a href="#" class="contact__social">
                                <img src="/images/gojek.svg" alt="Gojek">
                                <span>Gojek</span>
                            </a>

                            <a href="#" class="contact__social">
                                <img src="/images/grab.svg" alt="Grab">
                                <span>Grab</span>
                            </a>

                        </div>

                    </div>

                </div>

                <div class="contact__map"></div>

            </div>

        </div>

        <footer class="contact__footer">
            <span>© 2026 Clay. All rights reserved</span>
            <span>Designed by Djotaal</span>
        </footer>
        
    </section>


</Layout>