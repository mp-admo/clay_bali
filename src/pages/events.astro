---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Events | Clay Bali">

    <section id="events" class="events">

        <video class="hero__bg hero__bg--desktop" autoplay muted loop playsinline preload="auto">
            <source src="/video_hero_desktop_clay.mp4" type="video/mp4">
        </video>

        <video class="hero__bg hero__bg--mobile" autoplay muted loop playsinline preload="auto">
            <source src="/video_hero_mobile_clay.mp4" type="video/mp4">
        </video>

        <div class="hero__overlay"></div>

        <h1 class="hero__logo" data-i18n="soon"></h1>

        <div class="container">

            <div class="hero__bottom">

                <div class="hero__socials">
                    <a
                    href="#"
                    aria-label="Facebook" 
                    >
                        <img src="/facebook_icon_clay.svg" alt="" />
                    </a>

                    <a 
                    href="https://www.instagram.com/clay.bali?stkn=Nzk5ZmV2am03enU=" 
                    aria-label="Instagram" 
                    target="_blank">
                        <img src="/instagram_icon_clay.svg" alt="" />
                    </a>

                    <a 
                    href="https://wa.me/message/YW2DQFFZ7CY7L1" 
                    aria-label="WhatsApp" 
                    target="_blank">
                        <img src="/whatsapp_icon_clay.svg" alt="" />
                    </a>
                </div>

                <p class="hero__description" data-i18n="heroDescription"></p>

                <p class="hero__status" data-i18n="heroStatus"></p>

            </div>

        </div>

    </section>

    <style>

        .events {
            position: relative;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        .hero__bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover; 
            object-position: center; 
            z-index: 1; 
            pointer-events: none; 
            -webkit-user-drag: none; 
        }


        .hero__logo{
            font-size: 6.4rem;
            text-align: center;
            text-transform: uppercase;
            color: #FFF1D3;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
        }

        .container {
            width: 100%;
            max-width: 140rem;
            padding: 0 2rem;
            margin: 0 auto;
            position: relative;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            pointer-events: none;
        }

        .hero__bottom {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            z-index: 4; 
            pointer-events: auto;
            padding-bottom: 10rem;
            cursor: default; 
        }

        .hero__socials {
            display: flex;
            align-items: center;
            gap: 3.6rem;
        }

        .hero__socials a {
            display: block;
            width: 2.4rem;
            height: 2.4rem;
            transition: transform 0.2s ease;
        }

        .hero__socials img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .hero__socials a:hover {
            transform: translateY(-2px);
        }

        .hero__description {
            color: #FFF1D3;
            text-align: center;
            line-height: 1.5;
        }

        .hero__status {
            color: #FFF1D3;
            text-align: right;
            line-height: 1.5;
        }

        .hero__bg--mobile {
            display: none;
        }

        .hero__overlay {
            display: none;
        }

        @media (max-width: 1440px) {
            
            .hero__logo {
                font-size: 6rem;
            }

            .hero .container {
                padding: 0 5rem;
            }

            .hero__bottom {
                padding-bottom: 5rem;
            }

            .hero__description {
                font-size: 1.5rem;
            }

            .hero__status {
                font-size: 1.5rem;
            }

        }

        @media (max-width: 768px) {

            .events {
                height: 100svh;
            }

            .hero__bg--desktop {
                display: none;
            }

            .hero__bg--mobile {
                display: block;
            }

            .hero__logo {
                font-size: 6rem;
        
            }


            .hero .container {
                padding: 0 3rem;
            }

            .hero__bottom {
                display: flex;
                flex-direction: column;
                align-items: center;
                padding-bottom: 4rem;
                gap: 2.4rem;	 
            }

            .hero__socials {
                gap: 2.6rem;
            }

            .hero__socials a {
                width: 2.6rem;
                height: 2.6rem;
            }

            .hero__socials a:hover {
                transform: none;
            }


            .hero__description {
                font-size: 1.3rem;
            }

            .hero__status {
                text-align: center;
                font-size: 1.3rem;
            }

            .hero__overlay {
                display: block;
                position: absolute;
                inset: 0;
                z-index: 2;
                pointer-events: none;

                background:
                linear-gradient(
                    to bottom,
                    rgba(61, 20, 1, 1) 0%,
                    rgba(0, 0, 0, 0) 40%
                ),
                linear-gradient(
                    to top,
                    rgba(61, 20, 1, 1) 0%,
                    rgba(0, 0, 0, 0) 40%
                );
            }


        }

    </style>

    <style is:global>
        html,
        body {
            background-color: #3D1401;
        }
    </style>


</Layout>